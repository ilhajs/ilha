--- a/src/markdown/twoslash.ts
+++ b/src/markdown/twoslash.ts
@@ -45,7 +45,15 @@ export const blumeTwoslashTransformer = (): ShikiTransformer => {
     // Match the stock transformer's default: fence snippets are authored
     // bundler-style (extensionless relative imports, package imports).
     compilerOptions: {
+      jsx: tsModule.JsxEmit.ReactJSX,
+      jsxImportSource: "ilha",
+      types: ["bun"],
+      module: tsModule.ModuleKind.ESNext,
       moduleResolution: tsModule.ModuleResolutionKind.Bundler,
+      target: tsModule.ScriptTarget.ESNext,
+      strict: true,
+      esModuleInterop: true,
+      skipLibCheck: true,
     },
     // `require.resolve("typescript")` is the package's main entry,
     // `lib/typescript.js`; its directory holds the `lib.*.d.ts` default libs.
@@ -58,5 +66,13 @@ export const blumeTwoslashTransformer = (): ShikiTransformer => {
     rendererRich()
   )({
     explicitTrigger: true,
+    // Documentation snippets are intentionally partial; enhance valid spans
+    // without turning unresolved tutorial placeholders into build failures.
+    throws: false,
+    // Surface type errors in the build log — silent failures hide broken docs.
+    onTwoslashError: (error: unknown, code: string) => {
+      console.error(`[twoslash-code] >>>${code}<<<`);
+      console.error(`[twoslash-error] ${String(error).slice(0, 400)}`);
+    },
   });
 };
