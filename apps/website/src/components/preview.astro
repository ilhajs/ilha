---
/**
 * Embeds the Ilha playground for a code sample.
 * Used in MDX docs as <Preview code={example} size="lg" />.
 *
 * When `mobilePreview` is set, one iframe loads `mode=preview` below `sm`
 * and the full editor at `sm+` (src chosen client-side — never two iframes).
 *
 * `activate` controls when the iframe `src` is set:
 * - `eager` (default): load immediately
 * - `visible`: load when near the viewport
 * - `click`: show a centered CTA until the user clicks "Run playground"
 *   (always loads `mode=preview` — no editor pane)
 */
import { playgroundUrl } from "@/lib/playground";

interface Props {
  code: string;
  size?: "sm" | "lg";
  /** On viewports below `sm`, embed preview-only mode. */
  mobilePreview?: boolean;
  activate?: "eager" | "visible" | "click";
}

const { code, size, mobilePreview = false, activate = "eager" } = Astro.props;

const editorSrc = playgroundUrl(code);
const previewSrc = playgroundUrl(code, "preview");

// Explicit heights only — do not mix with h-full on the outer wrapper
// (parent often has no height, which collapses the iframe to ~150px).
let heightClass = "h-[32rem]";
if (size === "sm") {
  heightClass = "h-64";
} else if (size === "lg") {
  heightClass = mobilePreview
    ? "h-72 sm:h-[48rem] lg:h-[40rem]"
    : "h-[25rem] sm:h-[40rem]";
}

// Click-to-load always uses preview mode (code lives outside the frame).
const previewOnly = activate === "click";
const eager = activate === "eager";
let initialSrc: string | undefined;
if (eager && !mobilePreview) {
  initialSrc = editorSrc;
} else if (eager && mobilePreview) {
  initialSrc = previewSrc;
}
---

<div
  class:list={[
    "ilha-preview border-border bg-background relative flex w-full min-w-0 max-w-full overflow-hidden rounded-lg border",
    heightClass,
  ]}
  data-ilha-preview
  data-activate={activate}
  data-preview-src={previewSrc}
  data-editor-src={editorSrc}
  data-mobile-preview={mobilePreview && !previewOnly ? "" : undefined}
  data-preview-only={previewOnly ? "" : undefined}
  data-activated={eager ? "1" : undefined}
>
  {
    activate === "click" && (
      <div
        class="ilha-preview-gate bg-background absolute inset-0 z-10 flex flex-col items-center justify-center gap-3 p-6 text-center"
        data-ilha-preview-gate
      >
        <p class="text-muted-foreground m-0 max-w-[16rem] text-sm leading-relaxed">
          Try this tasks island live in the playground.
        </p>
        <button
          type="button"
          class="bg-primary text-primary-foreground hover:bg-primary/90 focus-visible:outline-ring inline-flex cursor-pointer items-center justify-center rounded-lg px-4 py-2 text-sm font-medium focus-visible:outline-2 focus-visible:outline-offset-2"
          data-ilha-preview-run
        >
          Run playground
        </button>
      </div>
    )
  }
  <iframe
    title="ilha playground"
    data-ilha-preview-frame
    src={initialSrc}
    loading="lazy"
    class="block h-full w-full min-w-0 max-w-full flex-1 border-0"
  >
  </iframe>
</div>

<script>
  const mq = () => window.matchMedia("(min-width: 640px)");

  (() => {
    const editorMode = (root: HTMLElement) => {
      if (Object.hasOwn(root.dataset, "previewOnly")) {
        return false;
      }
      return !Object.hasOwn(root.dataset, "mobilePreview") || mq().matches;
    };

    const targetSrc = (root: HTMLElement) => {
      const preview = root.dataset.previewSrc ?? "";
      const editor = root.dataset.editorSrc ?? "";
      return editorMode(root) ? editor : preview;
    };

    const syncMode = (root: HTMLElement) => {
      if (root.dataset.activated !== "1") {
        return;
      }
      if (!Object.hasOwn(root.dataset, "mobilePreview")) {
        return;
      }
      const frame = root.querySelector<HTMLIFrameElement>("[data-ilha-preview-frame]");
      if (!frame) {
        return;
      }
      const next = targetSrc(root);
      if (frame.getAttribute("src") !== next) {
        frame.src = next;
      }
    };

    const activate = (root: HTMLElement) => {
      if (root.dataset.activated === "1") {
        syncMode(root);
        return;
      }
      root.dataset.activated = "1";
      const frame = root.querySelector<HTMLIFrameElement>("[data-ilha-preview-frame]");
      if (!frame) {
        return;
      }
      frame.src = targetSrc(root);
      root.querySelector("[data-ilha-preview-gate]")?.remove();
    };

    const wire = (root: HTMLElement) => {
      const mode = root.dataset.activate ?? "eager";

      if (mode === "click") {
        root.querySelector("[data-ilha-preview-run]")?.addEventListener(
          "click",
          () => activate(root),
          { once: true },
        );
      } else if (mode === "visible") {
        const io = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              activate(root);
              io.disconnect();
            }
          },
          { rootMargin: "200px 0px" },
        );
        io.observe(root);
      } else {
        activate(root);
      }

      if (Object.hasOwn(root.dataset, "mobilePreview")) {
        mq().addEventListener("change", () => syncMode(root));
      }
    };

    for (const root of document.querySelectorAll<HTMLElement>("[data-ilha-preview]")) {
      wire(root);
    }
  })();
</script>
