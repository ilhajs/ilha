---
import { LayerCard } from "areia";

const cards = [
  {
    icon: "/code.svg",
    title: "Start with a function",
    description: "Write plain components first. Add an island boundary only when the UI needs one.",
  },
  {
    icon: "/thumb.svg",
    title: "Grow one capability at a time",
    description: "Add state, derived values, actions, and lifecycle hooks through one typed builder.",
  },
  {
    icon: "/link.svg",
    title: "Keep your server",
    description: "Any HTTP server can return Ilha’s rendered HTML. Client hydration stays opt-in.",
  },
  {
    icon: "/drop.svg",
    title: "Hydrate on demand",
    description: "Ship plain HTML first. Mount only the independently interactive islands that need JavaScript.",
  },
] as const;
---

<div
  data-hero-cards
  class="grid w-full grid-cols-1 gap-3 text-left sm:grid-cols-2 sm:gap-3.5 lg:grid-cols-4"
>
  {
    cards.map((card) => (
      <LayerCard data-hero-card class="h-full p-4">
        <div class="grid gap-1.5">
          <img src={card.icon} alt="" class="size-6 opacity-75" />
          <h3 class="text-base font-medium">{card.title}</h3>
          <p class="text-muted-foreground text-sm">{card.description}</p>
        </div>
      </LayerCard>
    ))
  }
</div>

