---
const cards = [
  {
    icon: "/code.svg",
    title: "Start with a function",
    description: "Write a component that returns JSX. Mount it when the UI needs to live in the browser.",
  },
  {
    icon: "/thumb.svg",
    title: "Grow one capability at a time",
    description: "Add atom(), watch(), streams, and when only where the view needs them.",
  },
  {
    icon: "/link.svg",
    title: "Keep your server",
    description: "Any HTTP server can return Ilha HTML. Client hydration stays opt-in.",
  },
  {
    icon: "/drop.svg",
    title: "Hydrate on demand",
    description: "Ship plain HTML first. Mount only the interactive regions that need JavaScript.",
  },
] as const;
---

<div
  data-hero-cards
  class="grid w-full grid-cols-1 gap-3 text-left sm:grid-cols-2 sm:gap-3.5 lg:grid-cols-4"
>
  {
    cards.map((card) => (
      <div data-hero-card class="card bg-base-100 h-full shadow">
        <div class="card-body gap-1.5 p-4">
          <img src={card.icon} alt="" class="size-6 opacity-75" />
          <h3 class="card-title text-base">{card.title}</h3>
          <p class="text-base-content/70 text-sm">{card.description}</p>
        </div>
      </div>
    ))
  }
</div>
