---
import data from "blume:data";
import PageLayout from "blume/components/layout/PageLayout.astro";
import Preview from "../src/components/preview.astro";
import IslandsDiagram from "../src/components/landing/islands-diagram.astro";
import { ProjectCreatorForm } from "../src/components/landing/landing";
import {
  DEFAULT_INSTALL_COMMAND,
  ILHA_ASTRO_CODE,
  ILHA_ROUTER_CODE,
  ILHA_CONTEXT_CODE,
  META_DESCRIPTION,
  PREVIEW_CODE,
  PRIMARY_ILHA_CARDS,
  URLS,
  USEFUL_EXTRAS_CARD,
} from "../src/lib/landing-const";
import { playgroundUrl } from "../src/lib/playground";
import "../src/styles/landing.css";
import { highlight } from "./_home/highlight";

const { config } = data;

const VITE_SPA_SANDBOX = `${URLS.SANDBOX.replace("{template}", "vite-spa")}?file=src%2Fpages%2Findex.tsx`;
const PLAYGROUND_URL = playgroundUrl(PREVIEW_CODE);
const SEO_TITLE = "Ilha - Server HTML first, islands where it matters";

const previewHtml = highlight(PREVIEW_CODE, "ts");
const routingHtml = highlight(ILHA_ROUTER_CODE, "ts");
const contextHtml = highlight(ILHA_CONTEXT_CODE, "ts");
const astroHtml = highlight(ILHA_ASTRO_CODE, "ts");

const HIGHLIGHTS = [
  { label: "Virtual DOM", value: "None" },
  { label: "Compiler", value: "None" },
  { label: "Component for server and client", value: "One" },
  { label: "Hydration", value: "Opt-in" },
] as const;

const MENTAL_MODEL = [
  { code: "() => JSX", text: "Write a component that returns JSX." },
  { code: "atom()", text: "Declare atom() values you read in the view." },
  { code: "await renderToString()", text: "Render the component to HTML on the server." },
  { code: "mount(..., { hydrate: true })", text: "Hydrate that HTML in the browser." },
] as const;

const EXTRAS = [
  { file: "vite.config.ts", html: routingHtml, label: "@ilha/router" },
  { file: "theme.tsx", html: contextHtml, label: "Context" },
  { file: "astro.config.ts", html: astroHtml, label: "@ilha/astro" },
] as const;
---

<PageLayout
  site={{ title: config.title, description: META_DESCRIPTION }}
  logo={config.logo}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  page={{ title: SEO_TITLE, description: META_DESCRIPTION, route: "/" }}
  themeMode={config.theme.mode}
  fontCssVars={data.fontCssVars}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  structuredDataEnabled={config.structuredData}
  x={config.x}
>
  <div class="landing-page bg-background text-foreground flex min-h-screen flex-col">
    <div id="main-content" class="flex-1">
      <section class="landing-hero border-border border-b">
        <div
          class="landing-shell grid min-w-0 gap-12 pt-16 pb-16 sm:gap-16 sm:pt-24 sm:pb-20 lg:pt-28"
        >
          <div class="landing-hero-copy landing-copy min-w-0 gap-6 sm:gap-8">
            <div class="grid w-full min-w-0 justify-items-center gap-5 sm:gap-6">
              <a href="/guide/getting-started/introduction" class="landing-pill">
                <span class="landing-pill-dot"></span>
                No virtual DOM. No compiler.
                <span aria-hidden="true" class="opacity-60">→</span>
              </a>
              <h1 class="landing-display">
                Server HTML first.<br />
                <span class="landing-display-accent">Islands where it matters.</span>
              </h1>
              <p class="landing-lede landing-lede-lg">
                Ilha is a tiny, isomorphic UI library. You write function components with
                <code>atom()</code> state, render them to HTML on the server, and hydrate only the
                regions that need JavaScript.
              </p>
            </div>
            <div class="grid w-full min-w-0 max-w-xl justify-items-stretch gap-3.5 sm:justify-items-center">
              <div class="flex w-full min-w-0 flex-col items-stretch gap-2.5 sm:flex-row sm:flex-wrap sm:items-center sm:justify-center sm:gap-3">
                <a
                  href="/guide/getting-started/installation"
                  class="btn btn-primary w-full justify-center sm:w-auto sm:flex-none"
                >
                  Get started
                </a>
                <a
                  href={VITE_SPA_SANDBOX}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn w-full justify-center sm:w-auto sm:flex-none"
                >
                  <img src="/stackblitz.svg" class="size-4" alt="" />
                  Open in StackBlitz
                </a>
              </div>
              <button
                type="button"
                class="landing-command btn btn-outline w-full min-w-0 justify-start overflow-hidden text-left font-mono"
                data-copy-command
                data-copy-value={DEFAULT_INSTALL_COMMAND}
              >
                <span aria-hidden="true" class="text-base-content/40">$</span>
                <span class="block min-w-0 flex-1 truncate" data-copy-label>{DEFAULT_INSTALL_COMMAND}</span>
                <img src="/copy.svg" class="size-4 shrink-0 opacity-60" alt="" />
                <span class="sr-only">Copy install command</span>
              </button>
            </div>
          </div>

          <div class="landing-hero-visual w-full min-w-0 max-w-full">
            <div class="landing-window">
              <div class="landing-window-bar">
                <span class="landing-dot"></span>
                <span class="landing-dot"></span>
                <span class="landing-dot"></span>
                <span class="landing-window-title">
                  <span class="font-mono">tasks.tsx</span>
                  <span class="text-base-content/40 hidden sm:inline">· playground.ilha.build</span>
                </span>
                <a
                  href={PLAYGROUND_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-ghost btn-xs gap-1.5"
                >
                  Open playground
                  <svg class="size-3.5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 3h6v6" />
                    <path d="M10 14 21 3" />
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                  </svg>
                </a>
              </div>
              <div class="landing-preview-split">
                <div class="landing-preview-code font-mono" set:html={previewHtml} />
                <div class="landing-preview-run">
                  <Preview code={PREVIEW_CODE} size="lg" mobilePreview activate="click" />
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="border-border border-b">
        <dl class="landing-shell landing-stats">
          {
            HIGHLIGHTS.map((item) => (
              <div class="landing-stat">
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="border-border border-b">
        <div class="landing-shell grid items-center gap-12 py-16 sm:py-20 lg:grid-cols-2 lg:gap-16 lg:py-24">
          <div class="grid gap-5">
            <p class="landing-eyebrow">The islands model</p>
            <h2 class="landing-section-title">Most of your page is HTML. Keep it that way.</h2>
            <p class="landing-lede">
              Use Ilha when you want server HTML plus a few interactive regions, not a full client
              app by default. Four steps cover the whole mental model.
            </p>
            <ol class="landing-steps">
              {
                MENTAL_MODEL.map((step, index) => (
                  <li>
                    <span class="landing-step-index">{index + 1}</span>
                    <span class="grid gap-1">
                      <span>{step.text}</span>
                      <code class="landing-step-code">{step.code}</code>
                    </span>
                  </li>
                ))
              }
            </ol>
          </div>
          <IslandsDiagram />
        </div>
      </section>

      {
        PRIMARY_ILHA_CARDS.map((tab, index) => {
          const reverse = index % 2 === 1;
          return (
            <section class="border-border border-b">
              <div class="landing-shell py-16 sm:py-20 lg:py-24">
                <div
                  class:list={[
                    "grid items-center gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-14 xl:gap-16",
                    reverse && "lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:[&>*:first-child]:order-2",
                  ]}
                >
                  <div class="grid gap-5">
                    <p class="landing-eyebrow">
                      <span class="landing-eyebrow-index">0{index + 1}</span>
                      {tab.label}
                    </p>
                    <h2 class="landing-section-title">{tab.title}</h2>
                    <p class="landing-lede">{tab.description}</p>
                    <ul class="landing-checks">
                      {tab.points.map((point) => (
                        <li>{point}</li>
                      ))}
                    </ul>
                  </div>
                  <div class="landing-window min-w-0">
                    <div class="landing-window-bar">
                      <span class="landing-dot" />
                      <span class="landing-dot" />
                      <span class="landing-dot" />
                      <span class="landing-window-title font-mono">{tab.file}</span>
                    </div>
                    <div class="landing-code font-mono">
                      <Fragment set:html={highlight(tab.code, "ts")} />
                    </div>
                  </div>
                </div>
              </div>
            </section>
          );
        })
      }

      <section class="border-border border-b">
        <div class="landing-shell py-16 sm:py-20 lg:py-24">
          <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:gap-14 xl:gap-16 lg:[&>*:first-child]:order-2">
            <div class="grid gap-5">
              <p class="landing-eyebrow">{USEFUL_EXTRAS_CARD.label}</p>
              <h2 class="landing-section-title">{USEFUL_EXTRAS_CARD.title}</h2>
              <p class="landing-lede">{USEFUL_EXTRAS_CARD.description}</p>
              <ul class="landing-checks">
                {USEFUL_EXTRAS_CARD.points.map((point) => <li>{point}</li>)}
              </ul>
            </div>
            <div class="landing-window landing-tabs min-w-0">
              {
                EXTRAS.map((extra, index) => (
                  <>
                    <input
                      type="radio"
                      name="landing_extras"
                      class="landing-tab"
                      aria-label={extra.label}
                      checked={index === 0}
                    />
                    <div class="landing-tab-panel">
                      <div class="landing-window-bar">
                        <span class="landing-window-title font-mono">{extra.file}</span>
                      </div>
                      <div class="landing-code font-mono">
                        <Fragment set:html={extra.html} />
                      </div>
                    </div>
                  </>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section class="border-border border-b">
        <div class="landing-shell grid items-start gap-10 py-16 sm:py-20 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-16 lg:py-24">
          <div class="grid gap-5 lg:sticky lg:top-24">
            <p class="landing-eyebrow">Start a project</p>
            <h2 class="landing-section-title">Scaffold a starter in one command.</h2>
            <p class="landing-lede">
              Pick a template, name your project, and copy the command. Each starter is a small,
              type-safe project you can read in a few minutes.
            </p>
            <p class="text-muted-foreground m-0 text-sm">
              Prefer to set it up yourself? Follow the{" "}
              <a href="/guide/getting-started/installation" class="text-foreground underline underline-offset-4">installation guide</a>.
            </p>
          </div>
          <div class="landing-window">
            <div class="p-5 sm:p-6">
              <ProjectCreatorForm client:only="@ilha/astro" />
            </div>
          </div>
        </div>
      </section>

      <section class="landing-close">
        <div class="landing-shell landing-copy gap-6 py-20 sm:py-24 lg:py-28">
          <p class="landing-eyebrow">Ready to build?</p>
          <h2 class="landing-section-title">Build your first component in five minutes.</h2>
          <p class="landing-lede">
            Read the introduction, or follow the counter tutorial from <code>atom()</code> to
            events to server rendering.
          </p>
          <div class="flex w-full flex-col justify-center gap-2.5 sm:w-auto sm:flex-row sm:gap-3">
            <a href="/guide/getting-started/introduction" class="btn btn-primary w-full sm:w-auto">
              Read the introduction
            </a>
            <a href="/tutorial/counter/atom" class="btn w-full sm:w-auto">
              Build the counter
            </a>
          </div>
        </div>
      </section>
    </div>

    <footer
      class="border-border text-muted-foreground mt-auto border-t px-5 py-8 text-center text-[0.875rem] leading-relaxed sm:px-6 sm:py-10"
    >
      Made with{" "}
      <a href="https://ilha.build" class="text-foreground hover:underline">Ilha</a>
      , in Europe ·
      <a
        href={URLS.GITHUB}
        target="_blank"
        rel="noopener noreferrer"
        class="text-foreground hover:underline"
      >
        GitHub
      </a>
    </footer>
  </div>
  <script>
    import { bindCopyCommandButtons } from "../src/scripts/copy-command.ts";

    bindCopyCommandButtons();
    document.addEventListener("astro:page-load", () => bindCopyCommandButtons());
  </script>
</PageLayout>
