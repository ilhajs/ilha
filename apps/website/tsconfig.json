{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "ilha",
    "strictNullChecks": true
  },
  "include": [
    ".blume/.astro/types.d.ts",
    "blume.config.ts",
    "components.ts",
    "docs/**/*",
    "pages/**/*",
    "src/**/*"
  ],
  "exclude": [".blume", "dist"]
}
