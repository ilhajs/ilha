{
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "templates/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter ilha build && bun run --filter './packages/*' build",
    "build:website": "bun run --filter website build",
    "cleanup": "bun run --parallel --filter '*' cleanup && rimraf node_modules",
    "lint:docs": "bun run --filter website lint:docs",
    "prepare": "husky",
    "test": "bun run --parallel --filter './packages/*' test",
    "typecheck": "bun run --filter ilha --filter @ilha/model typecheck",
    "typecheck:website": "bun run --filter website typecheck",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/bun": "^1.4.5",
    "husky": "^9.1.7",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "rimraf": "^6.1.4",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "ultracite": "8.3.1"
  },
  "patchedDependencies": {
    "blume@2.2.7": "patches/blume@2.2.7.patch"
  }
}
