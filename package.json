{
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "templates/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter ilha build && bun run --filter './packages/*' build",
    "build:website": "bun run --filter website build",
    "cleanup": "bun run --parallel --filter '*' cleanup && rimraf node_modules",
    "lint:docs": "bun run --filter website lint:docs",
    "prepare": "husky",
    "test": "bun run --parallel --filter './packages/*' test",
    "typecheck": "bun run --filter ilha typecheck",
    "typecheck:website": "bun run --filter website typecheck",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/bun": "^1.4.2",
    "husky": "^9.1.7",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.0",
    "typescript": "^7",
    "ultracite": "7.12.2"
  },
  "patchedDependencies": {
    "blume@2.1.0": "patches/blume@2.1.0.patch"
  }
}
