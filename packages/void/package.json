{
  "name": "@ilha/void",
  "version": "0.1.4",
  "description": "Ilha pages, server rendering, islands, forms, and navigation for Void",
  "keywords": [
    "frontend",
    "ilha",
    "island-architecture",
    "islands",
    "ssr",
    "vite",
    "void"
  ],
  "homepage": "https://github.com/ilhajs/ilha/tree/main/packages/void#readme",
  "bugs": {
    "url": "https://github.com/ilhajs/ilha/issues"
  },
  "license": "MIT",
  "author": "Ryuz <ryuzer@proton.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilhajs/ilha.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./islands": {
      "types": "./dist/islands.d.ts",
      "import": "./dist/islands.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "cleanup": "rimraf dist node_modules",
    "test": "bun test"
  },
  "devDependencies": {
    "ilha": "^0.16.0",
    "vite": "^8.3.1",
    "void": "^1.1.12"
  },
  "peerDependencies": {
    "ilha": ">=0.16.0",
    "vite": "^8.0.0",
    "void": "^1.1.12"
  }
}
