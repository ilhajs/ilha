{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "jsx": "react-jsx",
    "jsxImportSource": "ilha",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "paths": {
      "ilha": ["./src/index.ts"],
      "ilha/jsx-runtime": ["./src/jsx-runtime.ts"],
      "ilha/jsx-runtime.ts": ["./src/jsx-runtime.ts"],
      "ilha/jsx-dev-runtime": ["./src/jsx-dev-runtime.ts"],
      "ilha/jsx-dev-runtime.ts": ["./src/jsx-dev-runtime.ts"]
    },
    "strictNullChecks": true
  },
  "include": ["src", "tests", "happydom.ts"],
  "exclude": ["node_modules", "dist", "tsdown.config.ts"]
}
