{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["**/dist/**", "**/node_modules/**"],
  "jsPlugins": ["./packages/router/oxlint.cjs"],
  "rules": {
    "oxlint-plugin-ilha/no-conditional-primitive": "error",
    "oxlint-plugin-ilha/no-primitive-outside-component": "error",
    "oxlint-plugin-ilha/no-instruction-outside-generator": "error",
    "oxlint-plugin-ilha/prefer-lowercase-events": "error",
    "oxlint-plugin-ilha/function-in-atom": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.test.js"],
      "rules": {
        "oxlint-plugin-ilha/no-conditional-primitive": "off",
        "oxlint-plugin-ilha/no-primitive-outside-component": "off",
        "oxlint-plugin-ilha/no-instruction-outside-generator": "off",
        "oxlint-plugin-ilha/prefer-lowercase-events": "off",
        "oxlint-plugin-ilha/function-in-atom": "off"
      }
    }
  ]
}
